{
  "name": "fando-training-workshop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vue-tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "format:check": "prettier --check src docs README.md"
  },
  "dependencies": {
    "lucide-vue-next": "0.468.0",
    "vue": "3.5.21"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/tsconfig": "0.8.1",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.4.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "7.1.5",
    "vitest": "3.2.4",
    "vue-tsc": "3.0.6"
  }
}
